{
  "name": "dsh-wb-ui",
  "version": "0.1.0",
  "description": "WorkBuddy 工作台 UI 入口：在对话输入框旁提供一个启动器，集中展示助理/项目/专家/技能/连接器/自动化/资料库/飞书文档 八大功能，点击即可把指令填入输入框并执行。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "workbuddy",
    "ui",
    "launcher"
  ]
}
